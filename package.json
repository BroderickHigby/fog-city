{
  "name": "fog-city",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-web.ts",
    "build:web": "node scripts/build-web.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "shots": "playwright test --config tests/e2e/shots.config.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm e2e",
    "relay": "node server/main.ts",
    "relay:load": "node server/load/load-test.ts"
  },
  "dependencies": {
    "clipper-lib": "6.4.2",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "1.56.1",
    "@types/clipper-lib": "6.4.0",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "ajv": "8.20.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "mpg123-decoder": "1.0.3",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
