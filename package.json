{
  "name": "fog-city",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-web.ts",
    "build:web": "node scripts/build-web.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "soak:nightly": "vitest run --config tests/sim/nightly.vitest.config.ts",
    "e2e": "playwright test",
    "shots": "playwright test --config tests/e2e/shots.config.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm e2e",
    "world:pr": "vitest run --project world-pr",
    "world:nightly": "FOG_WORLD_NIGHTLY=1 vitest run --project world-nightly --maxWorkers=1 && playwright test --config tests/e2e/nightly.config.ts",
    "world:baseline": "node scripts/golden/world-baseline.ts",
    "tour": "playwright test --config tests/e2e/tour.config.ts",
    "server": "node server/main.ts",
    "test:net": "vitest run tests/net tests/server/net --maxWorkers=2"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "ajv": "8.20.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "1.3.0",
    "mpg123-decoder": "1.0.3",
    "polygon-clipping": "0.15.7",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
