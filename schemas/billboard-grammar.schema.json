{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/billboard-grammar",
  "title": "Billboard and ad-copy grammar (content/billboards.json)",
  "type": "object",
  "required": ["version", "start", "rules"],
  "properties": {
    "version": { "const": 1 },
    "start": { "type": "string" },
    "rules": {
      "type": "object",
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
    },
    "palettes": {
      "type": "array",
      "items": { "type": "object", "required": ["bg", "fg"], "properties": { "bg": { "type": "string" }, "fg": { "type": "string" } } }
    }
  }
}
