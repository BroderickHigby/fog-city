{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/bot-tells",
  "title": "Bot Hunt tells, false tells and robot archetypes (content/bot-tells.json)",
  "description": "Bot Hunt: tell the helpful robots from the bad ones by behaviour. A tell is BEHAVIOUR the sim can execute (a 'behaviour' object discriminated by 'kind'), never a colour code or a different body: every bad archetype shares its model with a good one. False tells are good-robot glitches that mimic bad tells. Cross-references (tell ids, models, opposing and mimicked tells, the difficulty curve, local tells) are checked by checkBotTells in src/content/botTells.ts.",
  "type": "object",
  "required": [
    "version",
    "scoring",
    "models",
    "lineSets",
    "tells",
    "archetypes",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "provenance": { "$ref": "#/$defs/provenance" },
    "version": {
      "const": 2
    },
    "$comment": {
      "type": "string"
    },
    "scoring": {
      "type": "object",
      "description": "Bot Hunt points (the Clean Streets table in docs/design.md). People are never valid targets: wetting one only costs the player.",
      "required": [
        "meltBad",
        "meltArmoured",
        "interruptUpdate",
        "rustGood",
        "wetPerson"
      ],
      "additionalProperties": false,
      "properties": {
        "meltBad": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "meltArmoured": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "interruptUpdate": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "rustGood": {
          "type": "integer",
          "exclusiveMaximum": 0
        },
        "wetPerson": {
          "type": "integer",
          "exclusiveMaximum": 0
        }
      }
    },
    "models": {
      "type": "object",
      "description": "Robot models by GLB stem (public/models/<id>.glb). Display names must be cleared (content/cleared-names.json).",
      "propertyNames": {
        "enum": [
          "errand-robot",
          "sidewalk-bot",
          "robotaxi"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "maker",
          "glb",
          "rustRate",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "maker": {
            "type": "string"
          },
          "glb": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.glb$"
          },
          "rustRate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "lineSets": {
      "type": "object",
      "description": "Short spoken lines referenced by behaviours (speech bubbles).",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "tells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "side",
          "subtlety",
          "channel",
          "models",
          "label",
          "description",
          "behaviour"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "side": {
            "enum": [
              "bad",
              "good"
            ]
          },
          "falseTell": {
            "const": true,
            "description": "A good robot's glitch that mimics bad tells; never proof on its own."
          },
          "mimics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "False tells only: the bad tells this glitch looks like."
          },
          "subtlety": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = obvious from across the street, 5 = only a patient watcher sees it."
          },
          "channel": {
            "enum": [
              "look",
              "path",
              "audio",
              "status",
              "speech"
            ],
            "description": "How a watcher reads it: look (the body), path (the Watch trail), audio (Watch isolates it), status (the public status light), speech (a bubble)."
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "errand-robot",
                "sidewalk-bot",
                "robotaxi"
              ]
            }
          },
          "districts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "description": "Local tells: the districts whose bounty sets use it."
          },
          "when": {
            "enum": [
              "rain",
              "fog",
              "night",
              "freeze"
            ],
            "description": "Only shown under this condition (freeze = the 3 a.m. firmware freeze)."
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "behaviour": {
            "$ref": "#/$defs/behaviour"
          },
          "opposes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Good tells only: bad tells this one contradicts, so it can never be worn as camouflage next to them."
          }
        },
        "if": {
          "required": [
            "falseTell"
          ]
        },
        "then": {
          "required": [
            "mimics"
          ],
          "properties": {
            "side": {
              "const": "good"
            }
          }
        },
        "else": {
          "properties": {
            "mimics": false
          }
        }
      }
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label",
          "model",
          "habitat",
          "tells",
          "difficulty",
          "designNote"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "kind": {
            "enum": [
              "bad",
              "good"
            ]
          },
          "label": {
            "type": "string"
          },
          "model": {
            "enum": [
              "errand-robot",
              "sidewalk-bot",
              "robotaxi"
            ]
          },
          "habitat": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/target"
            },
            "description": "Where it spawns."
          },
          "tells": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "falseTells": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "description": "Good archetypes: the glitches it shows now and then."
          },
          "difficulty": {
            "type": "array",
            "description": "Levels 1..5: which of its tells it shows (2-3 for a bad robot), how strongly, and (bad only) which good tells it wears as camouflage.",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "level",
                "showTells",
                "intensity",
                "camouflage"
              ],
              "additionalProperties": false,
              "properties": {
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "showTells": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "intensity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "description": "Multiplier on how often and how hard tells play."
                },
                "camouflage": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "designNote": {
            "type": "string",
            "minLength": 60,
            "description": "Docs-style note: what the joke is and who it punches at."
          },
          "restoredLine": {
            "type": "string",
            "description": "Bad robots: what it says when it is restored from backup at a repair kiosk after melting."
          },
          "wrongTargetLine": {
            "type": "string",
            "description": "Good robots: what it says when the player's stream rusts it past 0.3 and it limps to a repair kiosk."
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "bad"
            }
          }
        },
        "then": {
          "required": [
            "restoredLine"
          ],
          "properties": {
            "wrongTargetLine": false,
            "falseTells": false
          }
        },
        "else": {
          "required": [
            "wrongTargetLine",
            "falseTells"
          ],
          "properties": {
            "restoredLine": false
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "authorSession",
        "contentHash",
        "reviewedBy",
        "review"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "agent",
            "batch",
            "human"
          ]
        },
        "authorSession": {
          "type": "string",
          "minLength": 4
        },
        "contentHash": {
          "type": "string",
          "pattern": "^fnv1a32:[0-9a-f]{8}$",
          "description": "FNV-1a over the file's player-facing text joined by newlines (src/content/barks.ts contentHash)."
        },
        "reviewedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Reviewing agent sessions and, for sampled drops, the sample ids."
        },
        "review": {
          "type": "string"
        }
      },
      "description": "A copy of schemas/provenance.schema.json, inlined because tests/schemas/schemas.test.ts compiles this schema on its own; tests/content/provenance.test.ts keeps the copy equal."
    },
    "target": {
      "enum": [
        "robotaxiPickup",
        "billboard",
        "busShelter",
        "storefront",
        "marketQueue",
        "bakeryLine",
        "crosswalk",
        "busStop",
        "park",
        "door",
        "sidewalk",
        "chargingDock",
        "parkedCars",
        "garage",
        "hydrant",
        "road",
        "depotLot",
        "officeLobby",
        "turntable",
        "workbench",
        "drawbridge",
        "overlook"
      ]
    },
    "pos": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "behaviour": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "decal",
            "placement"
          ],
          "properties": {
            "kind": {
              "const": "decal"
            },
            "decal": {
              "enum": [
                "scuffedQrSticker",
                "conferenceLanyard",
                "fairSticker"
              ]
            },
            "placement": {
              "enum": [
                "back",
                "front"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lineSet",
            "radiusM",
            "cooldownS",
            "audience"
          ],
          "properties": {
            "kind": {
              "const": "askPassersBy"
            },
            "lineSet": {
              "type": "string"
            },
            "radiusM": {
              "$ref": "#/$defs/pos"
            },
            "cooldownS": {
              "$ref": "#/$defs/pos"
            },
            "audience": {
              "const": "adults"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "distanceM",
            "minDurationS"
          ],
          "properties": {
            "kind": {
              "const": "tailRobot"
            },
            "target": {
              "enum": [
                "goodErrandRobot",
                "goodSidewalkBot"
              ]
            },
            "distanceM": {
              "$ref": "#/$defs/pos"
            },
            "minDurationS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "workS",
            "intervalS"
          ],
          "properties": {
            "kind": {
              "const": "pastePoster"
            },
            "target": {
              "enum": [
                "billboard",
                "busShelter"
              ]
            },
            "workS": {
              "$ref": "#/$defs/pos"
            },
            "intervalS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "dwellS"
          ],
          "properties": {
            "kind": {
              "const": "parkAcross"
            },
            "target": {
              "enum": [
                "hydrant",
                "laneAhead"
              ]
            },
            "dwellS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "chime",
            "intervalS"
          ],
          "properties": {
            "kind": {
              "const": "tryCarDoors"
            },
            "chime": {
              "const": "pairing"
            },
            "intervalS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "sweepS",
            "intervalS"
          ],
          "properties": {
            "kind": {
              "const": "scanBeam"
            },
            "target": {
              "const": "numberPlates"
            },
            "sweepS": {
              "$ref": "#/$defs/pos"
            },
            "intervalS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "radiusM",
            "holdS"
          ],
          "properties": {
            "kind": {
              "const": "trackPlayer"
            },
            "radiusM": {
              "$ref": "#/$defs/pos"
            },
            "holdS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cycles"
          ],
          "properties": {
            "kind": {
              "const": "waitThroughSignal"
            },
            "cycles": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "walkAgainstFlow"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "shelter"
          ],
          "properties": {
            "kind": {
              "const": "skipRainCape"
            },
            "shelter": {
              "enum": [
                "awning",
                "busShelter",
                "arcade"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lineSet",
            "intervalS"
          ],
          "properties": {
            "kind": {
              "const": "loopLine"
            },
            "lineSet": {
              "type": "string"
            },
            "intervalS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "skipsSignals"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "emptyBag"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "puddleClearanceM",
            "hydrantClearanceM"
          ],
          "properties": {
            "kind": {
              "const": "avoidWater"
            },
            "puddleClearanceM": {
              "$ref": "#/$defs/pos"
            },
            "hydrantClearanceM": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "intervalS",
            "rangeM"
          ],
          "properties": {
            "kind": {
              "const": "humJingle"
            },
            "intervalS": {
              "$ref": "#/$defs/pos"
            },
            "rangeM": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "multiplier",
            "watchConeDeg"
          ],
          "properties": {
            "kind": {
              "const": "speedUpWhenWatched"
            },
            "multiplier": {
              "type": "number",
              "exclusiveMinimum": 1,
              "maximum": 3
            },
            "watchConeDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 180
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "radiusM",
            "dwellS"
          ],
          "properties": {
            "kind": {
              "const": "loiterNear"
            },
            "target": {
              "$ref": "#/$defs/target"
            },
            "radiusM": {
              "$ref": "#/$defs/pos"
            },
            "dwellS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bumpRadiusM"
          ],
          "properties": {
            "kind": {
              "const": "noApology"
            },
            "bumpRadiusM": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "statusPct"
          ],
          "properties": {
            "kind": {
              "const": "neverCharges"
            },
            "statusPct": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "steps",
            "loops"
          ],
          "properties": {
            "kind": {
              "const": "stepLoop"
            },
            "steps": {
              "type": "integer",
              "minimum": 2
            },
            "loops": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "densityAbove"
          ],
          "properties": {
            "kind": {
              "const": "avoidFog"
            },
            "densityAbove": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "periodS",
            "holdS"
          ],
          "properties": {
            "kind": {
              "const": "faceLightFlicker"
            },
            "periodS": {
              "$ref": "#/$defs/pos"
            },
            "holdS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "intervalS",
            "holdS"
          ],
          "properties": {
            "kind": {
              "const": "freezeMidStride"
            },
            "intervalS": {
              "$ref": "#/$defs/pos"
            },
            "holdS": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "loops"
          ],
          "properties": {
            "kind": {
              "const": "circleBlock"
            },
            "loops": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "takesStairs"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "approachM"
          ],
          "properties": {
            "kind": {
              "const": "neverArrives"
            },
            "approachM": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lagS",
            "maxDistanceM"
          ],
          "properties": {
            "kind": {
              "const": "mirrorPlayer"
            },
            "lagS": {
              "$ref": "#/$defs/pos"
            },
            "maxDistanceM": {
              "$ref": "#/$defs/pos"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "queueJump"
            },
            "target": {
              "const": "marketQueue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ignoresFreeze"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "laps"
          ],
          "properties": {
            "kind": {
              "const": "lapLoop"
            },
            "target": {
              "const": "park"
            },
            "laps": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "fullBag"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
