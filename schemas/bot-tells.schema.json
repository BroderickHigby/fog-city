{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/bot-tells",
  "title": "Bot Hunt tells and robot archetypes (content/bot-tells.json)",
  "type": "object",
  "required": ["version", "tells", "archetypes"],
  "properties": {
    "version": { "const": 1 },
    "tells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "side", "subtlety", "description"],
        "properties": {
          "id": { "type": "string" },
          "side": { "enum": ["bad", "good"] },
          "subtlety": { "type": "integer", "minimum": 1, "maximum": 5 },
          "description": { "type": "string" },
          "behaviour": { "type": "object" }
        }
      }
    },
    "archetypes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "tells"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["bad", "good"] },
          "label": { "type": "string" },
          "tells": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
