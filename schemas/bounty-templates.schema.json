{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/bounty-templates",
  "title": "Shared BotBounty templates (content/bounties.json)",
  "type": "object",
  "required": ["version", "crewSize", "pay", "provenance", "templates"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "$comment": { "type": "string" },
    "crewSize": {
      "type": "object", "required": ["min", "max", "withinM"], "additionalProperties": false,
      "properties": { "min": { "const": 2 }, "max": { "const": 4 }, "withinM": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "pay": {
      "type": "object", "required": ["standard", "armoured", "note"], "additionalProperties": false,
      "properties": { "standard": { "type": "integer", "minimum": 1 }, "armoured": { "type": "integer", "minimum": 1 }, "note": { "type": "string" } }
    },
    "provenance": { "$ref": "provenance" },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "crew", "headline", "lastSeen", "hint"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "crew": { "enum": ["crew", "single"], "description": "single: a lone baseline robot, the only kind allowed in a protected area." },
          "headline": { "type": "string", "minLength": 3, "maxLength": 48 },
          "lastSeen": { "type": "string", "minLength": 5, "pattern": "\\{place\\}" },
          "hint": { "type": "string", "minLength": 5, "pattern": "\\{tell\\}" }
        }
      }
    }
  }
}
