{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/brands",
  "title": "The game's invented brands (content/brands.json)",
  "description": "Display names for the invented companies, apps, robot models, stations, perks and the accelerator. Every name must be in content/cleared-names.json (checked by the content lint).",
  "type": "object",
  "required": ["version", "brands", "provenance"],
  "additionalProperties": false,
  "properties": {
    "provenance": { "$ref": "provenance" },
    "version": { "const": 1 },
    "$comment": { "type": "string" },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
          "kind": { "enum": ["company", "robotModel", "app", "station", "perk", "accelerator"] },
          "name": { "type": "string", "minLength": 2, "maxLength": 24 },
          "tagline": { "type": "string", "minLength": 2, "maxLength": 48 },
          "model": { "enum": ["errand-robot", "sidewalk-bot", "robotaxi"], "description": "The GLB in public/models/ (without .glb) that draws this robot model." },
          "maker": { "type": "string", "description": "Brand id of the company that makes this model." },
          "note": { "type": "string" }
        },
        "if": { "properties": { "kind": { "const": "robotModel" } } },
        "then": { "required": ["model", "maker"] }
      }
    }
  }
}
