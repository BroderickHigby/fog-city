{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/content-districts",
  "title": "Game districts (content/districts.json)",
  "description": "The game's districts by territory step, with a hub, a hand-traced polygon (WGS84 [lat, lon]) and the active flag that territory coverage reads. Distinct from the pipeline's public/tiles/sf/districts.json (DataSF Analysis Neighborhoods, geometry only).",
  "type": "object",
  "required": ["version", "source", "districts"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "$comment": { "type": "string" },
    "source": { "type": "string" },
    "districts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "step", "wave", "active", "hub", "polygon", "hook", "analysisNeighborhoods"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "maxLength": 22 },
          "step": { "type": "integer", "minimum": 1, "maximum": 10 },
          "wave": { "type": "integer", "minimum": 1, "maximum": 8 },
          "active": { "type": "boolean" },
          "hub": { "$ref": "#/$defs/labelledPoint" },
          "polygon": { "$ref": "places#/$defs/polygon" },
          "hook": { "type": "string" },
          "analysisNeighborhoods": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
        }
      }
    }
  },
  "$defs": {
    "labelledPoint": {
      "type": "object", "required": ["label", "lat", "lon"], "additionalProperties": false,
      "properties": { "label": { "type": "string" }, "lat": { "$ref": "places#/$defs/lat" }, "lon": { "$ref": "places#/$defs/lon" } }
    }
  }
}
