{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/crisis",
  "title": "The crisis check's phrases, look-alike table, sincere lines and resources (content/crisis.json; src/content/crisis.ts)",
  "type": "object",
  "required": [
    "version",
    "phrases",
    "patterns",
    "contractions",
    "compactStems",
    "normalise",
    "lines",
    "resources",
    "sources",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "phrases": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+( [a-z]+)*$"
      }
    },
    "lines": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 160,
        "not": {
          "pattern": "[!?]$|lol|haha|:\\)"
        },
        "description": "Sincere and plain: no exclamation, no joke, no emoji."
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "$comment": {
      "type": "string"
    },
    "phrases": {
      "type": "object",
      "required": [
        "selfHarm",
        "danger"
      ],
      "additionalProperties": false,
      "properties": {
        "selfHarm": {
          "$ref": "#/$defs/phrases"
        },
        "danger": {
          "$ref": "#/$defs/phrases"
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "description": "Slot lists expanded to every combination and matched as whole words: one alternative from each slot, in order. '' makes a slot optional. notFollowedBy cancels a match when the next word is one of these ('hit me up').",
      "items": {
        "type": "object",
        "required": [
          "group",
          "slots"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "enum": [
              "selfHarm",
              "danger"
            ]
          },
          "note": {
            "type": "string"
          },
          "slots": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([a-z]+( [a-z]+)*)?$"
              }
            }
          },
          "notFollowedBy": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+$"
            }
          }
        }
      }
    },
    "contractions": {
      "type": "object",
      "minProperties": 10,
      "description": "Contractions (after apostrophes are dropped) and slang expanded before matching: isnt -> is not, wanna -> want to.",
      "propertyNames": {
        "pattern": "^[a-z]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z]+( [a-z]+)*$"
      }
    },
    "compactStems": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{5,}$"
      },
      "description": "Matched inside the text with every space removed; only stems no ordinary word contains."
    },
    "normalise": {
      "type": "object",
      "minProperties": 10,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z]{1,2}$"
      }
    },
    "lines": {
      "type": "object",
      "required": [
        "selfHarm",
        "danger"
      ],
      "additionalProperties": false,
      "properties": {
        "selfHarm": {
          "$ref": "#/$defs/lines"
        },
        "danger": {
          "$ref": "#/$defs/lines"
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "detail",
          "groups"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "detail": {
            "type": "string",
            "maxLength": 120
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "selfHarm",
                "danger"
              ]
            },
            "description": "The groups whose response lists this resource."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "provenance": {
      "$ref": "provenance"
    }
  }
}
