{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/landmark-tags",
  "title": "The places table of hero landmarks: tagged records, materials and storefront rule (content/landmark-tags.json)",
  "description": "House kit K10 (world QA W-27, L-04). A building entry's point is a probe resolved the way pipeline/areas.json probes are; the listed podium records (and their towers and pieces) are tagged meta.landmark and drawn in the material with no office window grid and no shop band. A site entry has no record.",
  "type": "object",
  "required": ["version", "materials", "landmarks", "provenance"],
  "additionalProperties": false,
  "properties": {
    "provenance": { "$ref": "provenance" },
    "version": { "const": 1 },
    "$comment": { "type": "string" },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-zA-Z]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["wall", "trim", "roof"],
        "additionalProperties": false,
        "properties": {
          "wall": { "$ref": "#/$defs/hex" },
          "trim": { "$ref": "#/$defs/hex" },
          "roof": { "$ref": "#/$defs/hex" },
          "note": { "type": "string" }
        }
      }
    },
    "landmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "point", "records", "shopBand", "storefronts"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "The landmark id: content/landmarks.json uses the same id for the model that replaces these records." },
          "kind": { "enum": ["building", "site"] },
          "label": { "type": "string" },
          "point": {
            "type": "object",
            "required": ["lat", "lon"],
            "additionalProperties": false,
            "properties": {
              "lat": { "type": "number", "minimum": 37.6, "maximum": 37.9 },
              "lon": { "type": "number", "minimum": -122.6, "maximum": -122.3 },
              "radiusM": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }
            }
          },
          "records": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" } },
          "material": { "type": "string", "pattern": "^[a-z][a-zA-Z]*$" },
          "shopBand": { "const": false, "description": "Landmarks never carry the ground-floor shop band." },
          "storefronts": { "type": "boolean", "description": "Whether storefront anchors on the tagged records are drawn." },
          "publishedHeightM": { "type": "number", "exclusiveMinimum": 0, "maximum": 400, "description": "The published height above its ground, for the model and interim-shape tests." },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$", "description": "sRGB colour, lower-case hex." }
  }
}
