{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/mission",
  "title": "Mission (content/missions/*.json), interpreted by the sim mission runtime",
  "description": "A mission is a graph of steps discriminated by 'type'. Execution starts at 'start' (default: the first step) and ends at a step that names an outcome (reward without next, retry, end). Places are WGS84 lat/lon; the game projects them with src/geo/project.ts. Graph rules JSON Schema cannot express (every target resolves, timers are feasible, meters stay bounded, every answer path terminates and every outcome is reachable) are checked by validateMission in src/content/missions.ts.",
  "type": "object",
  "required": ["id", "version", "title", "cast", "meters", "outcomes", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "const": 1 },
    "$comment": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "area": { "type": "string" },
    "start": { "$ref": "#/$defs/stepId" },
    "cast": {
      "type": "object",
      "description": "Everyone who speaks. Invented characters only; caricatures of public figures get invented names.",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "meters": {
      "type": "object",
      "description": "Bounded numeric meters (e.g. conviction). Every change is clamped to [min, max].",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["label", "start", "min", "max"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "start": { "type": "number" },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    },
    "outcomes": {
      "type": "object",
      "description": "How a run can end. success: rewards granted; retry: the mission can be replayed from a step; fail: it cannot.",
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "kind"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "kind": { "enum": ["success", "retry", "fail"] }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "stepId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "seconds": { "type": "number", "exclusiveMinimum": 0 },
    "clock": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "In-game time of day, HH:MM." },
    "line": {
      "type": "object",
      "required": ["speaker", "text"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "type": "string", "description": "A cast id." },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } },
    "place": {
      "type": "object",
      "required": ["label", "lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "radiusM": { "type": "number", "exclusiveMinimum": 0, "description": "Arrival radius." },
        "headingDeg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "description": "Compass bearing an object here faces (billboards: the direction its face looks)." },
        "source": { "type": "string", "description": "Where the coordinates came from." }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "enum": ["trigger", "goto", "timer", "dialogue", "branch", "reward", "retry", "end"] },
        "note": { "type": "string" }
      },
      "oneOf": [
        { "$ref": "#/$defs/trigger" },
        { "$ref": "#/$defs/goto" },
        { "$ref": "#/$defs/timer" },
        { "$ref": "#/$defs/dialogue" },
        { "$ref": "#/$defs/branch" },
        { "$ref": "#/$defs/reward" },
        { "$ref": "#/$defs/retry" },
        { "$ref": "#/$defs/end" }
      ]
    },
    "trigger": {
      "description": "Starts the mission when an event happens (a phone call while the player is at a place, or entering an area).",
      "type": "object",
      "required": ["id", "type", "event", "next"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "trigger" },
        "note": { "type": "string" },
        "event": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "caller", "place"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "phoneCall" },
                "caller": { "type": "string", "description": "A cast id." },
                "place": { "$ref": "#/$defs/place" },
                "clock": { "$ref": "#/$defs/clock" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "place"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "enterArea" },
                "place": { "$ref": "#/$defs/place" },
                "clock": { "$ref": "#/$defs/clock" }
              }
            }
          ]
        },
        "lines": { "$ref": "#/$defs/lines" },
        "next": { "$ref": "#/$defs/stepId" }
      }
    },
    "goto": {
      "description": "Reach target.place within timer.limitS; 'next' on arrival, 'onTimeout' when the timer runs out.",
      "type": "object",
      "required": ["id", "type", "target", "timer", "next", "onTimeout"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "goto" },
        "note": { "type": "string" },
        "target": { "allOf": [{ "$ref": "#/$defs/place" }, { "type": "object", "required": ["radiusM"] }] },
        "timer": {
          "type": "object",
          "required": ["limitS"],
          "additionalProperties": false,
          "properties": {
            "limitS": { "$ref": "#/$defs/seconds" },
            "warnAtS": { "$ref": "#/$defs/seconds", "description": "Seconds remaining when the HUD warns." },
            "label": { "type": "string" },
            "deadline": { "$ref": "#/$defs/clock" }
          }
        },
        "travel": { "enum": ["any", "vehicle", "foot"] },
        "lines": { "$ref": "#/$defs/lines" },
        "next": { "$ref": "#/$defs/stepId" },
        "onTimeout": { "$ref": "#/$defs/stepId" }
      }
    },
    "timer": {
      "description": "Wait durationS (lines play meanwhile), then go to next.",
      "type": "object",
      "required": ["id", "type", "durationS", "next"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "timer" },
        "note": { "type": "string" },
        "durationS": { "$ref": "#/$defs/seconds" },
        "lines": { "$ref": "#/$defs/lines" },
        "next": { "$ref": "#/$defs/stepId" }
      }
    },
    "dialogue": {
      "description": "The speaker asks each question in order; each answer adds its delta to the meter (clamped) and plays the reply.",
      "type": "object",
      "required": ["id", "type", "speaker", "meter", "questions", "next"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "dialogue" },
        "note": { "type": "string" },
        "speaker": { "type": "string" },
        "meter": { "type": "string" },
        "intro": { "$ref": "#/$defs/lines" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "prompt", "answers"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
              "prompt": { "type": "string", "minLength": 1 },
              "answers": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["id", "text", "delta", "reply"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                    "text": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "delta": { "type": "integer" },
                    "reply": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        },
        "next": { "$ref": "#/$defs/stepId" }
      }
    },
    "branch": {
      "description": "Go to the first case whose [min, max] contains the meter's value, else 'default'.",
      "type": "object",
      "required": ["id", "type", "meter", "cases", "default"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "branch" },
        "note": { "type": "string" },
        "meter": { "type": "string" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["next"],
            "anyOf": [{ "required": ["min"] }, { "required": ["max"] }],
            "additionalProperties": false,
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "next": { "$ref": "#/$defs/stepId" }
            }
          }
        },
        "default": { "$ref": "#/$defs/stepId" }
      }
    },
    "reward": {
      "description": "Grants rewards. Ends the run with 'outcome' unless 'next' continues it.",
      "type": "object",
      "required": ["id", "type", "outcome", "grants"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "reward" },
        "note": { "type": "string" },
        "outcome": { "type": "string" },
        "lines": { "$ref": "#/$defs/lines" },
        "grants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "corridor", "place", "copy"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "billboard" },
                  "corridor": { "type": "string" },
                  "place": { "allOf": [{ "$ref": "#/$defs/place" }, { "type": "object", "required": ["headingDeg"] }] },
                  "copy": {
                    "type": "object",
                    "required": ["generator", "product"],
                    "additionalProperties": false,
                    "properties": {
                      "generator": { "enum": ["billboard", "busWrap"], "description": "src/content/billboards.ts kind." },
                      "product": { "const": "playerStartup", "description": "Advertise the player's own startup name." }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "stat", "delta"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "stat" },
                  "stat": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                  "delta": { "type": "integer" }
                }
              }
            ]
          }
        },
        "next": { "$ref": "#/$defs/stepId" }
      }
    },
    "retry": {
      "description": "Ends the run with 'outcome'; the mission can be replayed from 'retryFrom'.",
      "type": "object",
      "required": ["id", "type", "outcome", "retryFrom"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "retry" },
        "note": { "type": "string" },
        "outcome": { "type": "string" },
        "lines": { "$ref": "#/$defs/lines" },
        "hint": { "type": "string", "description": "What to do before trying again." },
        "cooldownS": { "$ref": "#/$defs/seconds" },
        "retryFrom": { "$ref": "#/$defs/stepId" }
      }
    },
    "end": {
      "description": "Ends the run with 'outcome'.",
      "type": "object",
      "required": ["id", "type", "outcome"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "const": "end" },
        "note": { "type": "string" },
        "outcome": { "type": "string" },
        "lines": { "$ref": "#/$defs/lines" }
      }
    }
  }
}
