{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/name-parts",
  "title": "Pre-cleared name parts for composed startup and player names (content/name-parts.json; src/content/composer.ts)",
  "type": "object",
  "required": [
    "version",
    "pools",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 24
        },
        "text": {
          "type": "string",
          "pattern": "^[A-Z][a-z]+$",
          "minLength": 2,
          "maxLength": 8,
          "description": "One capitalised word; composed names stay within 16 characters (composer.ts COMPOSED_NAME_MAX)."
        }
      }
    },
    "tail": {
      "type": "object",
      "required": [
        "id",
        "text",
        "glue"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 24
        },
        "text": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z]*$",
          "minLength": 2,
          "maxLength": 7
        },
        "glue": {
          "enum": [
            "space",
            "camel"
          ],
          "description": "space: 'Kelp Labs'; camel: 'KelpStack'."
        }
      }
    },
    "pool": {
      "type": "array",
      "minItems": 40,
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "$comment": {
      "type": "string"
    },
    "pools": {
      "type": "object",
      "required": [
        "startupHead",
        "startupTail",
        "playerAdjective",
        "playerNoun"
      ],
      "additionalProperties": false,
      "properties": {
        "startupHead": {
          "$ref": "#/$defs/pool"
        },
        "startupTail": {
          "type": "array",
          "minItems": 20,
          "items": {
            "$ref": "#/$defs/tail"
          }
        },
        "playerAdjective": {
          "$ref": "#/$defs/pool"
        },
        "playerNoun": {
          "type": "array",
          "minItems": 40,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/part"
              },
              {
                "properties": {
                  "text": {
                    "maxLength": 7,
                    "type": "string"
                  }
                },
                "type": "object"
              }
            ]
          }
        }
      }
    },
    "removed": {
      "type": "array",
      "description": "Parts taken out of the pools and why: AI jargon that collides with real startups across the board, or a web-searched conflict with a real tech, robotics, transport or fintech company. No pool may hold a removed id (tests/content/composer.test.ts).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "pool",
          "kind",
          "searchedOn",
          "queries",
          "findings",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "text": {
            "type": "string",
            "minLength": 2
          },
          "pool": {
            "enum": [
              "startupHead",
              "startupTail",
              "playerAdjective",
              "playerNoun"
            ]
          },
          "kind": {
            "enum": [
              "jargon",
              "conflict"
            ]
          },
          "searchedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "findings": {
            "type": "string",
            "minLength": 10
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "conflict"
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "properties": {
            "queries": {
              "type": "array",
              "minItems": 1
            },
            "sources": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    },
    "provenance": {
      "$ref": "provenance"
    }
  }
}
