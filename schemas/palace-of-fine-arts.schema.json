{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/point"
      },
      "minItems": 3,
      "maxItems": 4096
    }
  },
  "$id": "fog-city/palace-of-fine-arts",
  "title": "Original Palace geometry and raw-record replacement contract",
  "required": [
    "id",
    "version",
    "world",
    "frame",
    "origin",
    "source",
    "replacesBuildingIds",
    "colliders",
    "provenance"
  ],
  "properties": {
    "id": {
      "const": "palace-of-fine-arts"
    },
    "version": {
      "const": 1
    },
    "world": {
      "const": "sf"
    },
    "frame": {
      "const": "glTF local metres, +Y up, -Z front"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon",
        "headingDeg"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "headingDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        }
      }
    },
    "source": {
      "type": "string",
      "minLength": 10
    },
    "replacesBuildingIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "colliders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "footprint",
          "baseY",
          "topY"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^palace:"
          },
          "footprint": {
            "$ref": "#/$defs/polygon"
          },
          "baseY": {
            "type": "number"
          },
          "topY": {
            "type": "number"
          },
          "underY": {
            "type": "number"
          }
        }
      }
    },
    "provenance": {
      "$ref": "provenance"
    }
  }
}
