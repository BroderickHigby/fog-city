{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/startup-kits",
  "title": "Startup kits for One-Sentence Startup (content/startup-kits.json; src/content/kits.ts)",
  "type": "object",
  "required": [
    "version",
    "kits",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "copy": {
      "type": "object",
      "required": [
        "headline",
        "subline"
      ],
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 2
        },
        "subline": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "slide": {
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "problem",
            "solution",
            "market",
            "traction",
            "ask"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 90
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "$comment": {
      "type": "string"
    },
    "kits": {
      "type": "array",
      "minItems": 150,
      "items": {
        "type": "object",
        "required": [
          "id",
          "keywords",
          "nameParts",
          "nounPhrase",
          "tagline",
          "slides",
          "billboard",
          "busWrap",
          "palette"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9 -]*$"
            }
          },
          "nameParts": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "nounPhrase": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32
          },
          "tagline": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32
          },
          "slides": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "prefixItems": [
              {
                "$ref": "#/$defs/slide",
                "properties": {
                  "kind": {
                    "const": "problem"
                  }
                },
                "type": "object"
              },
              {
                "$ref": "#/$defs/slide",
                "properties": {
                  "kind": {
                    "const": "solution"
                  }
                },
                "type": "object"
              },
              {
                "$ref": "#/$defs/slide",
                "properties": {
                  "kind": {
                    "const": "market"
                  }
                },
                "type": "object"
              },
              {
                "$ref": "#/$defs/slide",
                "properties": {
                  "kind": {
                    "const": "traction"
                  }
                },
                "type": "object"
              },
              {
                "$ref": "#/$defs/slide",
                "properties": {
                  "kind": {
                    "const": "ask"
                  }
                },
                "type": "object"
              }
            ]
          },
          "billboard": {
            "$ref": "#/$defs/copy"
          },
          "busWrap": {
            "$ref": "#/$defs/copy"
          },
          "palette": {
            "type": "integer",
            "minimum": 0,
            "maximum": 13
          },
          "fallback": {
            "const": true
          }
        }
      }
    },
    "provenance": {
      "$ref": "provenance"
    }
  }
}
