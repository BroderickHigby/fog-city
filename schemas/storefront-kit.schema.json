{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/storefront-kit",
  "title": "Storefront types by business category (content/storefronts.json). Unnamed: iconography only.",
  "type": "object",
  "required": ["version", "types"],
  "properties": {
    "version": { "const": 1 },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "naicsPrefixes", "signShape"],
        "properties": {
          "id": { "type": "string" },
          "naicsPrefixes": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2,6}$" } },
          "signShape": { "type": "string" },
          "props": { "type": "array", "items": { "type": "string" } },
          "signText": { "description": "Reserved for later. Must be absent or null for now.", "type": "null" }
        }
      }
    }
  }
}
