{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/street-cleaning",
  "title": "Street Cleaning rules per road edge side (public/tiles/<world>/street-cleaning.json). Ids use street_cleaning in game data.",
  "type": "object",
  "required": [
    "version",
    "world",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "world": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge",
          "side",
          "day",
          "fromHour",
          "toHour",
          "weeks",
          "holidays"
        ],
        "additionalProperties": false,
        "properties": {
          "edge": {
            "type": "string"
          },
          "side": {
            "enum": [
              "L",
              "R"
            ]
          },
          "day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7,
            "description": "ISO weekday 1-7; 0 = holidays only"
          },
          "fromHour": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "toHour": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "weeks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "holidays": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
