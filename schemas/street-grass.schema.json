{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/street-grass",
  "title": "Render-only DataSF RPD Lawn pieces, in local metres",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "world", "snapshotDate", "attribution", "source", "grass"],
  "properties": {
    "version": { "const": 1 },
    "world": { "const": "sf" },
    "snapshotDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "attribution": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "url", "license", "licenseUrl", "selection", "compiledSourceCommit", "compiledSourcePath", "compiledSourceSha256", "originalResponseSha256", "originalResponseNote", "snapshotSha256", "worldBounds", "sourcePieces", "excludedSourceIds"],
      "properties": {
        "dataset": { "const": "38b7-6db3" },
        "url": { "const": "https://data.sf.gov/resource/38b7-6db3.json" },
        "license": { "const": "ODC PDDL 1.0" },
        "licenseUrl": { "const": "http://opendatacommons.org/licenses/pddl/1.0/" },
        "selection": { "const": "functional_area_type = 'Lawn'" },
        "compiledSourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "compiledSourcePath": { "const": "public/tiles/sf/street-landcover.json" },
        "compiledSourceSha256": { "$ref": "#/$defs/sha256" },
        "originalResponseSha256": { "$ref": "#/$defs/sha256" },
        "originalResponseNote": { "type": "string", "minLength": 1 },
        "snapshotSha256": { "$ref": "#/$defs/sha256" },
        "worldBounds": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": -20000, "maximum": 20000 } },
        "sourcePieces": { "type": "integer", "minimum": 0 },
        "excludedSourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^rpd:[\\w.-]+:\\d+@-?\\d+,-?\\d+$" } }
      }
    },
    "grass": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "rings"],
        "properties": {
          "id": { "type": "string", "pattern": "^rpd:[\\w.-]+:\\d+(~[0-9a-f]{12})?@-?\\d+,-?\\d+$" },
          "sourceId": { "type": "string", "pattern": "^rpd:[\\w.-]+:\\d+@-?\\d+,-?\\d+$" },
          "kind": { "const": "lawn" },
          "rings": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "array", "minItems": 6, "items": { "type": "number", "minimum": -20000, "maximum": 20000 } }
          }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
