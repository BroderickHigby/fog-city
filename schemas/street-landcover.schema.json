{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/street-landcover",
  "title": "Lawns and fences from San Francisco Recreation and Parks (public/tiles/<world>/street-landcover.json, pipeline/lib/landcover.ts).",
  "type": "object",
  "required": [
    "version",
    "world",
    "grass",
    "barriers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "world": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "snapshotDate": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "grass": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "rings"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "lawn",
              "meadow",
              "pitch",
              "natural"
            ]
          },
          "rings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 6,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "barriers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "h",
          "pts"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "fence",
              "wall",
              "hedge",
              "rail"
            ]
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 6
          },
          "pts": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
