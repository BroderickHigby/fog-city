{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fog-city/writing-bank",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "entries",
    "provenance"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "wave",
          "context",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9-]*$"
          },
          "wave": {
            "type": "integer",
            "minimum": 2,
            "maximum": 8
          },
          "context": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9-]*$"
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "score",
                "reply"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "score": {
                  "type": "integer",
                  "minimum": -2,
                  "maximum": 2
                },
                "reply": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9-]*$"
            }
          },
          "followUpId": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9-]*$"
          }
        }
      }
    },
    "provenance": {
      "$ref": "provenance"
    }
  }
}
