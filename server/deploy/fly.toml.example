# Fly.io example (not deployed). Copy to fly.toml at the repository root, set app, then:
#   fly launch --no-deploy --copy-config && fly deploy
app = "fog-city-relay"
primary_region = "sjc"

[build]
  dockerfile = "server/deploy/Dockerfile"

[env]
  # The page origin(s) that may connect, comma-separated, e.g. the static game's host.
  ALLOWED_ORIGINS = "https://your-game.example"
  # Fly puts the real client address in this header; per-IP limits use it.
  CLIENT_IP_HEADER = "fly-client-ip"

[http_service]
  internal_port = 8787
  force_https = true
  auto_stop_machines = "off"
  min_machines_running = 1
  [[http_service.checks]]
    method = "GET"
    path = "/health"
    interval = "30s"
    timeout = "5s"
    grace_period = "60s"

[[vm]]
  # The SF sim world takes ~0.9 GB; each live match about a third of a CPU core.
  memory = "2gb"
  cpus = 2
